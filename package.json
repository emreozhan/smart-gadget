{
  "name": "smart-gadget",
  "version": "1.0.0",
  "description": "Yeelight akilli lamba kontrolcusu - tepsi ikonu, mini mod, her zaman ustte",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icons": "node tools/gen-icons.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.emreozhan.smartgadget",
    "productName": "Smart Gadget",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": ["portable"],
      "icon": "assets/icon.ico"
    }
  }
}
